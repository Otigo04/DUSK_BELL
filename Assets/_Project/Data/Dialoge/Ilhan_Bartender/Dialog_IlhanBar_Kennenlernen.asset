  m_Script: {fileID: 11500000, guid: b2cbeb950ed5773488e142ea53a23cb0, type: 3}
  m_Name: Dialog_IlhanBar_Kennenlernen
  m_EditorClassIdentifier: Assembly-CSharp::Nightward.Dialogue.DialogueAsset
  startNode: start
  nodes:
  - id: start
    speaker: 0
    text: 'Setz dich, wo Platz ist. Ein Bier, ein Tee oder einfach Gesellschaft?
      Alles kostet hier dasselbe: ein paar ehrliche Worte.'
    relationship: 0
    setFlag: ilhan_bar_kennengelernt
    next: 
    choices:
    - text: Ein Tee, bitte.
      next: tee
      relationship: 1
      setFlag: 
      minRelationship: -10
      requireFlag: 
    - text: Was ist hier los im Dorf?
      next: dorf
      relationship: 0
      setFlag: 
      minRelationship: -10
      requireFlag: 
    - text: "Ich will nur nicht drau\xDFen sein."
      next: draussen
      relationship: 0
      setFlag: 
      minRelationship: -10
      requireFlag: 
  - id: tee
    speaker: 0
    text: "Kamille mit Honig. Hilft gegen Albtr\xE4ume. Zumindest redet man es sich
      ein."
    relationship: 0
    setFlag: 
    next: 
    choices: []
  - id: dorf
    speaker: 0
    text: "Nachts klopft es. Wer aufmacht, kommt nicht wieder. Wer zu laut zuh\xF6rt,
      schl\xE4ft schlecht."
    relationship: 0
    setFlag: 
    next: dorf2
    choices: []
  - id: dorf2
    speaker: 0
    text: 'Merk dir: Echte Nachbarn betteln um Einlass. Die anderen sagen immer denselben
      Satz.'
    relationship: 0
    setFlag: 
    next: 
    choices: []
  - id: draussen
    speaker: 0
    text: Kluger Mann. Oder kluge Frau. Bleib, solange die Laternen brennen.
    relationship: 0
    setFlag: 
    next: 
    choices: []
