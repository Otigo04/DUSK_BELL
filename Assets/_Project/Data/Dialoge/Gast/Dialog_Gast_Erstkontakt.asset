      requireFlag: 
  - id: name
    speaker: 0
    text: "Ich habe den Namen eines Mannes, der verschwunden ist. Er passt mir gut.
      M\xF6chtest du ihn h\xF6ren?"
    relationship: 0
    setFlag: 
    next: 
    choices: []
  - id: woher
    speaker: 0
    text: Von weit her. Ich warte gern. Eine Nacht mehr oder weniger macht mir nichts.
    relationship: 0
    setFlag: 
    next: 
    choices: []
  - id: tschuess
    speaker: 0
    text: "Nat\xFCrlich. Ich komme wieder. Ich klopfe dreimal."
    relationship: 0
