  startNode: start
  nodes:
  - id: start
    speaker: 0
    text: "Ah. Der Neuzugang. Man hat mir von Ihnen erz\xE4hlt. Mein Name ist Elenora.
      Die Villa liegt am Ende der Stra\xDFe. Ich erwarte Sie dort, wenn es Ihnen
      recht ist."
    relationship: 0
    setFlag: elenora_kennengelernt
    noFarewell: 0
    next: 
    choices:
    - text: Ich komme vielleicht vorbei.
      next: vielleicht
      relationship: 0
      setFlag: 
      minRelationship: -10
      requireFlag: 
    - text: Wer sind Sie?
      next: wer
      relationship: 0
      setFlag: 
      minRelationship: -10
      requireFlag: 
    - text: Kein Interesse.
      next: nein
      relationship: -1
      setFlag: 
      minRelationship: -10
      requireFlag: 
  - id: vielleicht
    speaker: 0
    text: "Wie \xFCberaus freundlich. Ich lasse Tee bereitstellen."
    relationship: 0
    setFlag: 
    noFarewell: 0
    next: 
    choices: []
  - id: wer
    speaker: 0
    text: "Eine Anw\xE4ltin, fr\xFCher. Jetzt die Hausherrin. Ordnung ist das Einzige,
      was in diesem Dorf Bestand hat."
    relationship: 0
    setFlag: 
    noFarewell: 0
    next: 
    choices: []
  - id: nein
    speaker: 0
    text: "Wie Sie w\xFCnschen. Man \xFCberlegt es sich meist anders."
    relationship: 0
    setFlag: 
    noFarewell: 0
    next: 
    choices: []
