  m_Script: {fileID: 11500000, guid: b2cbeb950ed5773488e142ea53a23cb0, type: 3}
  m_Name: Dialog_Bulut_Kennenlernen
  m_EditorClassIdentifier: Assembly-CSharp::Nightward.Dialogue.DialogueAsset
  startNode: start
  nodes:
  - id: start
    speaker: 0
    text: Halt. Ich kenne hier jedes Gesicht. Deins nicht. Name, Herkunft, Absicht.
    relationship: 0
    setFlag: bulut_kennengelernt
    next: 
    choices:
    - text: Ich bin nur auf der Durchreise.
      next: reise
      relationship: 0
      setFlag: 
      minRelationship: -10
      requireFlag: 
    - text: "Ich will helfen, die Nacht zu \xFCberstehen."
      next: helfen
      relationship: 1
      setFlag: 
      minRelationship: -10
      requireFlag: 
    - text: Seit wann fragt hier einer?
      next: frech
      relationship: -2
      setFlag: 
      minRelationship: -10
      requireFlag: 
  - id: reise
    speaker: 0
    text: "Durchreise endet bei D\xE4mmerung. Danach sitzt du fest. Wie wir alle."
    relationship: 0
    setFlag: 
    next: 
    choices: []
  - id: helfen
    speaker: 0
    text: "Hilfe kann ich brauchen. Aber wer hilft, h\xF6rt auf mich. Wenn ich die
      Glocke l\xE4ute, bist du drinnen."
    relationship: 0
    setFlag: 
    next: 
    choices: []
  - id: frech
    speaker: 0
    text: Seit der Wald nachts Besuch schickt. Merk dir das.
    relationship: 0
    setFlag: 
    next: 
    choices: []
